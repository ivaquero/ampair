# ============================================================================
# genus-primer-pipeline - main entry point (orchestrator)
#
# For a given bacterial genus and one or more housekeeping genes:
#   download genomes -> extract gene -> dereplicate -> align ->
#   design primers -> quality filter -> in silico PCR -> per-gene HTML report
#
# This Snakefile loads config, defines ALL shared path variables, and
# includes the rule modules under workflow/rules/. Rule bodies live in their
# own .smk files and rely on the variables defined here. The single conda
# environment in workflow/envs/environment.yaml is activated before running;
# no per-rule conda directives are used.
#
# Usage (from project root, with the conda env active):
#   snakemake --cores 4
# ============================================================================

import os
import sys
from pathlib import Path

def _resolve_scripts_dir():
    # Snakemake may execute this Snakefile from its runtime source cache.  A
    # path derived from __file__ can then contain the cache prefix followed by
    # the original checkout path, which is not a real filesystem location.
    # Prefer the checkout's working directory for normal source runs; keep the
    # resource-based candidates for installed-package consumers.
    candidates = [
        Path.cwd().resolve() / "workflow" / "scripts",
    ]

    if "__file__" in globals():
        candidates.append(Path(__file__).resolve().parent / "scripts")

    try:
        config_schema_path = Path(
            workflow.source_path("scripts/config_schema.py")
        ).resolve()
        candidates.append(config_schema_path.parent)
    except (OSError, ValueError):
        pass

    for candidate in candidates:
        if (candidate / "config_schema.py").is_file():
            return candidate

    searched = "\n".join(str(candidate) for candidate in candidates)
    raise ModuleNotFoundError(f"Cannot find config_schema.py. Searched:\n{searched}")


SCRIPTS_DIR = _resolve_scripts_dir()
WORKFLOW_DIR = SCRIPTS_DIR.parent
sys.path.insert(0, str(SCRIPTS_DIR))

from config_schema import apply_config_defaults, validate_config

CONFIG_FILE = os.environ.get("AMPAIR_CONFIG_FILE", "config/config.yaml")
configfile: CONFIG_FILE


config.update(apply_config_defaults(config))
validate_config(config)

wildcard_constraints:
    gene = r"[^./]+"

# ---------------------------------------------------------------------------
# Shared variables - defined ONCE here, used by every included module
# ---------------------------------------------------------------------------
GENUS = config["genus"]
GENES = config["genes"]

# Per-genus result tree keeps multiple genus runs cleanly separated
RESULTS = Path("results") / GENUS

GENOMES_GENOMIC = RESULTS / "genomes" / "genomic"
GENOMES_CDS     = RESULTS / "genomes" / "cds"
GENOMES_RNA     = RESULTS / "genomes" / "rna"
EXTRACTED       = RESULTS / "extracted"
ALIGNED         = RESULTS / "aligned"
PRIMERS         = RESULTS / "primers"
REPORTS         = RESULTS / "reports"

# ---------------------------------------------------------------------------
# Top-level target: one HTML report per gene
# ---------------------------------------------------------------------------
rule all:
    input:
        expand(str(REPORTS / "{gene}_report.html"), gene=GENES),
        str(REPORTS / "gene_report_cross.html")

# ---------------------------------------------------------------------------
# Include rule modules (paths relative to this Snakefile in workflow/)
# ---------------------------------------------------------------------------
include: workflow.source_path("rules/genomes_download.smk")
include: workflow.source_path("rules/gene_extract.smk")
include: workflow.source_path("rules/cluster.smk")
include: workflow.source_path("rules/align.smk")
include: workflow.source_path("rules/primers_design.smk")
include: workflow.source_path("rules/primers_check.smk")
include: workflow.source_path("rules/in_silico_pcr.smk")
include: workflow.source_path("rules/reports.smk")
